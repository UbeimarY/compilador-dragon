// ================================================================
//  programa_correcto.drg — Simulador de combate contra un dragón
//  Caso de prueba 1: flujo correcto completo
//  Tokens → AST → Semántico → TAC → Optimización → Ensamblador
// ================================================================

texto heroe = "Aria";
entero vida_dragon = 120;
entero ataque_base = 10 * 2 + 5;       // plegado de constantes → 25
real multiplicador = 1.5;
entero turno = 1;
booleano dragon_vivo = verdadero;
booleano modo_depuracion = falso;

// Función con parámetros, variables locales y varios 'retornar'
funcion entero calcular_dano(entero base, entero numero_turno) {
    si (numero_turno % 3 == 0) {
        real critico = base * multiplicador;   // coerción implícita entero → real
        imprimir("¡Golpe crítico!");
        imprimir(critico);
        retornar base * 2;
    } sino si (numero_turno % 2 == 0) {
        retornar base - 5;                     // el dragón se defiende
    }
    retornar base + numero_turno;              // ataque normal con bonificación
}

/* Este bloque nunca se ejecuta: el optimizador lo
   detecta y lo elimina como código inalcanzable. */
si (modo_depuracion) {
    imprimir("[debug] iniciando simulación");
}

texto inicio = "Comienza la batalla de " + heroe;   // reserva memoria en el heap
imprimir(inicio);
liberar(inicio);                                     // y la devuelve

mientras (dragon_vivo && turno <= 6) {
    entero dano = calcular_dano(ataque_base, turno);
    vida_dragon = vida_dragon - dano;
    si (vida_dragon <= 0) {
        vida_dragon = 0;
        dragon_vivo = falso;
    }
    imprimir(turno);
    imprimir(vida_dragon);
    turno = turno + 1;
}

si (!dragon_vivo) {
    texto victoria = heroe + " derrotó al dragón";
    imprimir(victoria);
    liberar(victoria);
} sino {
    imprimir("El dragón escapó");
}

real promedio = (120 - vida_dragon) / (turno - 1.0);   // daño promedio por turno
imprimir(promedio);
